{
	"name": "bbuilds-web-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:unit:run": "vitest --run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:e2e:ci": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"test:e2e:codegen": "playwright codegen http://localhost:4173",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"types:storyblok": "node --env-file=.env scripts/generate-storyblok-types.mjs && prettier --write src/lib/types/storyblok.d.ts",
		"typecheck": "npm run check",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write ."
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"eslint --fix --max-warnings 0 --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,jsonc,md,css,html,yml,yaml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/gtag.js": "^0.0.20",
		"@types/node": "^26.1.1",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.10.5",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"playwright": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storyblok": "^4.19.1",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.9",
		"vitest-browser-svelte": "^2.2.0",
		"wrangler": "^4.111.0"
	},
	"dependencies": {
		"@storyblok/svelte": "^7.2.0",
		"@tsparticles/engine": "^4.3.2",
		"@tsparticles/plugin-emitters": "^4.3.2",
		"@tsparticles/plugin-emitters-shape-square": "^4.3.2",
		"@tsparticles/slim": "^4.3.2"
	}
}
